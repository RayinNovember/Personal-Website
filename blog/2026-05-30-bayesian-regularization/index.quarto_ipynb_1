        "#| label: fig-elastic-net\n",
        "#| fig-cap: Elastic Net prior for different λ₁ and λ₂ combinations\n",
        "#| fig-alt: Four Elastic Net distributions showing how varying lambda1 and lambda2 shifts the prior between Laplace-like and Gaussian-like behaviour\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = np.linspace(-5, 5, 1000)\n",
        "dx = x[1] - x[0]\n",
        "\n",
        "def elastic_net_prior(x, lambda1, lambda2):\n",
        "    unnorm = np.exp(-lambda1 * np.abs(x) - lambda2 * x**2)\n",
        "    return unnorm / (unnorm.sum() * dx)\n",
        "\n",
        "params = [\n",
        "    {\"lambda1\": 2.0, \"lambda2\": 0.2, \"color\": \"#E07B54\", \"label\": \"λ₁=2.0, λ₂=0.2  (Lasso-like)\"},\n",
        "    {\"lambda1\": 1.0, \"lambda2\": 1.0, \"color\": \"#1D9E75\", \"label\": \"λ₁=1.0, λ₂=1.0  (balanced)\"},\n",
        "    {\"lambda1\": 0.2, \"lambda2\": 2.0, \"color\": \"#7F77DD\", \"label\": \"λ₁=0.2, λ₂=2.0  (Ridge-like)\"},\n",
        "]\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "\n",
        "for p in params:\n",
        "    density = elastic_net_prior(x, p[\"lambda1\"], p[\"lambda2\"])\n",
        "    ax.plot(x, density, color=p[\"color\"], lw=2.5, label=p[\"label\"])\n",
        "    ax.fill_between(x, density, alpha=0.08, color=p[\"color\"])\n",
        "\n",
        "ax.axvline(0, color=\"#888780\", lw=1, linestyle=\"--\", alpha=0.5)\n",
