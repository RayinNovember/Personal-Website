        "#| label: fig-weibull-dist\n",
        "#| fig-cap: 'Weibull distribution: PDF, survival, and hazard for varying $\\nu$'\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "lam = 1.0                        # fix scale parameter\n",
