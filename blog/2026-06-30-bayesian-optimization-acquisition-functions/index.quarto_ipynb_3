        "---\n",
        "title: \"Bayesian Optimization - Acquisition Functions\"\n",
        "author: Ray Wang\n",
        "date: \"2026-06-30\"\n",
        "description: \"A deep dive into the acquisition functions.\"\n",
        "categories: [Machine Learning, Gaussian Processes, Bayesian]\n",
        "image: sidebar.png\n",
        "format:\n",
